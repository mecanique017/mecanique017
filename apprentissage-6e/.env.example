# Copie ce fichier en « .env » puis renseigne ta clé API Claude (https://platform.claude.com/).
# Sans clé, l'application fonctionne quand même avec le moteur d'exercices hors ligne.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération (par défaut : claude-opus-5-5).
# Pour réduire les coûts : claude-sonnet-5-5 ou claude-haiku-5-5.
AI_MODEL=claude-opus-5-5

# Effort de réflexion pour les séries d'exercices : low (rapide) | medium | high
AI_EFFORT=low

# Nombre maximum de générations par heure (protection des coûts)
AI_RATE_LIMIT_PER_HOUR=60

# Port et adresse d'écoute. HOST=0.0.0.0 pour y accéder depuis une tablette du même réseau Wi-Fi.
PORT=3000
HOST=127.0.0.1
