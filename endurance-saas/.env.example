# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Anthropic Claude API (Backend uniquement)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stripe (Paiements)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role (serveur uniquement, contourne la RLS : webhook Stripe)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe : identifiants des prix des offres (Dashboard Stripe → Produits)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# URL publique du site (redirections après paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Polar AccessLink (https://admin.polaraccesslink.com) : synchronisation des séances
# URL de redirection à déclarer chez Polar : https://<domaine>/api/polar/callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

# E-mails (Resend : https://resend.com) — domaine d'envoi vérifié requis
RESEND_API_KEY=re_...
EMAIL_FROM="Endurance SaaS <coach@votre-domaine.fr>"
# Signature des liens de désinscription (32 caractères minimum) : openssl rand -base64 48
EMAIL_UNSUBSCRIBE_SECRET=

# Tâches planifiées (Vercel Cron, voir vercel.json) : openssl rand -base64 32
CRON_SECRET=
